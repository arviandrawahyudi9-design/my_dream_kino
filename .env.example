# Telegram Bot Token BotFather'dan olinadi
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Admin foydalanuvchi ID si
ADMIN_ID=123456789

# Majburiy obuna kanali (username masalan: @kanal_nomi yoki ID masalan: -1001234567890)
CHANNEL_ID=@your_public_channel

# Kinolar saqlanadigan yopiq kanal ID si (masalan: -1009876543210)
# Bot bu yopiq kanalda Admin bo'lishi shart!
MOVIE_CHANNEL_ID=-1009876543210

# Supabase Project Settings > API dan oling. Service role kalitini faqat Render'da saqlang.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Vercel frontend manzili (masalan: https://my-dream-kino.vercel.app)
FRONTEND_URL=https://your-project.vercel.app
